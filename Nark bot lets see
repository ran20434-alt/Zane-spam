@bot.tree.command(name="ping", description="Check Nark's ping / latency")
async def ping(interaction: discord.Interaction):
    ws_latency = round(bot.latency * 1000)
    start = time.perf_counter()
    await interaction.response.defer()
    api_latency = round((time.perf_counter() - start) * 1000)
    total = ws_latency + api_latency

    if total < 100:
        emoji = "🟢"
        mood = "Ekdom mast! Kya baat hai jaan 😎"
    elif total < 250:
        emoji = "🟡"
        mood = "Theek hai, chal raha hai 😏"
    else:
        emoji = "🔴"
        mood = "Uff, dimaag garam hai! Thoda wait kar 😅"

    embed = discord.Embed(
        title="🏓 Pong!",
        description=f"{emoji} {mood}",
        color=0x00ffcc
    )
    embed.add_field(name="Websocket", value=f"`{ws_latency}ms`", inline=True)
    embed.add_field(name="API", value=f"`{api_latency}ms`", inline=True)
    embed.add_field(name="Total", value=f"`{total}ms`", inline=True)
    embed.set_footer(text=f"Nark • Owner: {OWNER_NAME} 👑")
    await interaction.followup.send(embed=embed)

