    lbl.TextWrapped = true
    lbl.Parent = frame
    task.delay(4.5, function()
        if bb and bb.Parent then
            TweenSvc:Create(frame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
            TweenSvc:Create(lbl, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
            TweenSvc:Create(s, TweenInfo.new(0.5), {Transparency = 1}):Play()
            task.wait(0.5)
            bb:Destroy()
        end
    end)
end

