local RgbLabels = {}
RunService.RenderStepped:Connect(function()
    local rainbowHue = (tick() % 3) / 3
    local color = Color3.fromHSV(rainbowHue, 1, 1)
    local hex = string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
    local now = os.time()
    for lbl, data in pairs(RgbLabels) do
