local function playSoundObj(snd, title)
    if musicState.sound then
        pcall(function() musicState.sound:Stop(); musicState.sound:Destroy() end)
    end
    musicState.sound = snd
    snd.Volume = musicState.volume
    snd.Looped = musicState.looping
    if pcall(function() snd:Play() end) then
        musicState.playing = true
        setNowPlaying(title or "Playing")
        setMusicStatus("Active")
    else
        setNowPlaying("No music playing")
        setMusicStatus("Playback error")
    end
