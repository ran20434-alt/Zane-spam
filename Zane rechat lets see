openProfilePopup = function(uid, displayName, username)
    if not uid then return end
    currentProfileUserId = uid
    ProfileTitle.Text = "Profile"
    ProfileAvatarImg.Image = ""
    ProfileDisplayName.Text = "<b>" .. tostring(displayName or username or ("User " .. tostring(uid))) .. "</b>"
    ProfileUsername.Text = "@" .. tostring(username or displayName or ("User " .. tostring(uid)))
    FollowerNumLbl.Text = "…"
    FollowingNumLbl.Text = "…"
    updateFollowBtnState(uid)
    if ProfileListCard.Visible then ProfileListCard.Visible = false end
    slideIn(ProfileCard)

    task.spawn(function()
        local pfp = getUserPFP(uid)
        if pfp then ProfileAvatarImg.Image = pfp
        else
            pcall(function()
                local thumb = Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                if thumb and ProfileAvatarImg and ProfileAvatarImg.Parent then
                    ProfileAvatarImg.Image = thumb
                end
            end)
        end
    end)

    task.spawn(function()
        local fc = fetchFollowerCount(uid)
        local gc = fetchFollowingCount(uid)
        if FollowerNumLbl and FollowerNumLbl.Parent then FollowerNumLbl.Text = tostring(fc) end
        if FollowingNumLbl and FollowingNumLbl.Parent then FollowingNumLbl.Text = tostring(gc) end
    end)

    task.spawn(function()
        local myFollowData = getFirebaseData("following/" .. tostring(UserId))
        if myFollowData and type(myFollowData) == "table" then
            myFollowing[tostring(uid)] = (myFollowData[tostring(uid)] == true) or nil
        else
            myFollowing[tostring(uid)] = nil
        end
        updateFollowBtnState(uid)
    end)
end

UIS.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not ProfileCard.Visible and not ProfileListCard.Visible then return end
    local pos = input.Position
    local function inside(frame)
        local p = frame.AbsolutePosition
        local s = frame.AbsoluteSize
        return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
    end
    if ProfileListCard.Visible then
        if not inside(ProfileListCard) then
            slideOut(ProfileListCard, function()
                if ProfileCard.Visible then slideIn(ProfileCard) end
            end)
        end
    elseif ProfileCard.Visible then
        if not inside(ProfileCard) then closeProfile() end
    end
end)

