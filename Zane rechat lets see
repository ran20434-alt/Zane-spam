            if data.expiresAt then
                local remain = data.expiresAt - now
                if remain <= 0 then
                    titleSuffix = " ⌛"
                else
                    local m = math.floor(remain / 60)
                    local s = remain % 60
                    local timeStr = m > 0 and (m .. "m" .. s .. "s") or (s .. "s")
                    titleSuffix = " ⏳" .. timeStr
                end
            end
            if data.isImg then
                lbl.Text = string.format("<font color=\"%s\"><b>%s%s</b></font> <b>%s</b>", hex, data.rankTitle, titleSuffix, data.dispName)
            else
                lbl.Text = string.format("<font color=\"%s\"><b>%s%s</b></font> <b>%s:</b> %s", hex, data.rankTitle, titleSuffix, data.dispName, data.msgText)
            end
        else
            RgbLabels[lbl] = nil
        end
    end
end)

local function showHeadBubble(senderIdentifier, text)
    if not text or text == "" then return end
    local targetPlr = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == senderIdentifier:lower() or p.DisplayName:lower() == senderIdentifier:lower() or tostring(p.UserId) == tostring(senderIdentifier) then
            targetPlr = p
            break
        end
    end
    if not targetPlr then return end
    local char = targetPlr.Character or targetPlr.CharacterAdded:Wait()
    local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 2)
    if not head then return end
    local oldBB = head:FindFirstChild("ZaNeHeadBubble")
    if oldBB then oldBB:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name = "ZaNeHeadBubble"
    bb.Adornee = head
    bb.Size = UDim2.new(0, 220, 0, 60)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 150
    bb.Parent = head
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(18, 12, 28)
    frame.BackgroundTransparency = 0.1
    frame.Parent = bb
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 10) c.Parent = frame
    local s = Instance.new("UIStroke") s.Color = C.ACCENT s.Thickness = 2 s.Parent = frame
