task.spawn(function()
    while true do
        syncRanks()

        if not isDirectorUser(PlayerName) then
            local banCheckLive = getFirebaseData("bans/" .. PlayerName:lower())
            if banCheckLive and banCheckLive.banned then
                Player:Kick("🔨 You are banned by Staff " .. (banCheckLive.by or "Staff") .. ". Reason: " .. (banCheckLive.reason or "Banned"))
            end
        end

        local data = getFirebaseData("servers/" .. SERVER_KEY .. "/messages")
        if data then
            for id, frame in pairs(messageFrames) do
                if not data[id] then
                    if frame and frame.Parent then frame:Destroy() end
                    messageFrames[id] = nil
                    renderedMessageIds[id] = nil
                    messageTextLabels[id] = nil
                end
            end

            for id, msg in pairs(data) do
                if not processedMessages[id] then
                    processedMessages[id] = true
                    if msg.timestamp and msg.timestamp >= sessionStartTime then
                        if (msg.Sender or msg.sender) ~= PlayerName then
                            renderMessageItem(msg, id)
                        end
                    end
                else
                    if messageFrames[id] then
                        local msgContent = messageFrames[id]:FindFirstChild("Frame")
                        local bub = msgContent and msgContent:FindFirstChild("Frame")
                        if bub then
                            local rx = bub:FindFirstChild("ReactionLabel")
                            if rx and msg.reaction then rx.Text = msg.reaction end
                        end
                    end
                end
            end
        end

        -- Inline PVT listener (DMS tab removed, only inline PVT persists)
        if inlinePvtTarget then
            local dmKey = getDMChannelKey(UserId, inlinePvtTarget.UserId)
            if not processedDMs then processedDMs = {} end
            if not processedDMs[dmKey] then processedDMs[dmKey] = {} end
            local dmData = getFirebaseData("dm_channels/" .. dmKey)
            if dmData then
                for id, msg in pairs(dmData) do
                    if not processedDMs[dmKey][id] then
                        processedDMs[dmKey][id] = true
                        if (msg.Sender or msg.sender) ~= PlayerName then
                            addMsg(msg.Sender or msg.sender, msg.DisplayName or msg.sender, msg.Text or "", MsgScroll, false, nil, msg.UserId, id, msg.replyData, nil, true)
                            sendBigWhiteNotification("🔒 PVT from @" .. (msg.DisplayName or msg.Sender))
                        end
                    end
                end
            end
        end

        -- Global YouTube music listener
        local ytData = getFirebaseData("servers/" .. SERVER_KEY .. "/global_music_youtube")
        if ytData and ytData.nonce and ytData.nonce ~= lastPlayedYTNonce then
            lastPlayedYTNonce = ytData.nonce
            if ytData.playedBy ~= PlayerName then
                if ytData.url == "STOP" then
                    if musicState.sound then
                        pcall(function() musicState.sound:Stop(); musicState.sound:Destroy() end)
                        musicState.sound = nil
                        musicState.playing = false
                    end
                    setNowPlaying("No music playing")
                    setMusicStatus("Stopped by " .. tostring(ytData.playedBy or "someone"))
                    sendBigWhiteNotification("🔇 Global music stopped by " .. tostring(ytData.playedBy or "someone"))
                else
                    task.spawn(function()
                        sendBigWhiteNotification("🎵 Downloading global music from " .. tostring(ytData.playedBy or "someone"))
                        setMusicStatus("📡 Downloading from " .. tostring(ytData.playedBy or "someone") .. "...")
                        DLBarBG.Visible = true
                        DLBarFill.Size = UDim2.new(0, 0, 1, 0)

                        local id, err = musicStartDownload(ytData.url)
                        if not id then
                            setMusicStatus("Broadcast download failed")
                            DLBarBG.Visible = false
                            return
                        end
                        local dlUrl, info = musicPollProgress(id, function(pct)
                            DLBarFill.Size = UDim2.new(pct / 100, 0, 1, 0)
                            setMusicStatus("📡 " .. pct .. "%")
                        end)
                        if not dlUrl then
                            setMusicStatus("Broadcast failed")
                            DLBarBG.Visible = false
                            return
                        end
                        local saved, pathOrErr = musicSaveFile(dlUrl, "zane_" .. tostring(id):sub(-8))
                        DLBarBG.Visible = false
                        if not saved then
                            setMusicStatus("Save error (broadcast)")
                            return
                        end
                        refreshMusicLibrary()
                        local title = (info and info.title) or ytData.title or "YouTube Audio"
                        local snd = Instance.new("Sound")
                        snd.Name = "ZaNeMusic_" .. tick()
                        if getcustomasset then snd.SoundId = getcustomasset(pathOrErr)
                        else snd.SoundId = "rbxasset://" .. pathOrErr end
                        snd.Volume = musicState.volume
                        snd.Looped = musicState.looping
                        snd.Parent = workspace
                        task.wait(0.5)
                        playSoundObj(snd, title)
                        sendBigWhiteNotification("🎵 Now playing: " .. title)
                    end)
                end
            end
        end

        if isInitialLoad then isInitialLoad = false end

        local musicData = getFirebaseData("servers/" .. SERVER_KEY .. "/global_music")
        if musicData and musicData.audioId and musicData.audioId ~= lastPlayedMusicId then
            lastPlayedMusicId = musicData.audioId
            if musicData.audioId == "0" then
                globalSound:Stop()
            else
                globalSound.SoundId = "rbxassetid://" .. musicData.audioId
                globalSound:Play()
            end
        end

        local volData = getFirebaseData("servers/" .. SERVER_KEY .. "/global_volume")
        if volData and volData.volume and currentGlobalVolume ~= volData.volume then
            currentGlobalVolume = volData.volume
            globalSound.Volume = currentGlobalVolume
            soundGroup.Volume = currentGlobalVolume
        end

        task.wait(0.4)
    end
end)

