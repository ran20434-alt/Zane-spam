local function openHoldMenu(msgId, sender, dispName, text, bubFrame)
    if not msgId then return end
    ContextMenu.Visible = false
    ReactionPicker.Visible = false
    for _, child in ipairs(ContextMenu:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local isOwn = (sender == PlayerName)
    local posY = math.clamp(bubFrame.AbsolutePosition.Y - SrvPage.AbsolutePosition.Y + 20, 10, SrvPage.AbsoluteSize.Y - 180)
    local posX = math.clamp(bubFrame.AbsolutePosition.X - SrvPage.AbsolutePosition.X + 36, 10, SrvPage.AbsoluteSize.X - 200)
    ContextMenu.Position = UDim2.new(0, posX, 0, posY)

    if isOwn then
        createContextMenuBtn("✏️ Edit Message", function()
            CInput.Text = text
            CInput:CaptureFocus()
            deleteFirebaseData("servers/" .. SERVER_KEY .. "/messages/" .. msgId)
            sendBigWhiteNotification("✏️ Message deleted, edit and resend")
        end)
        createContextMenuBtn("📋 Copy Message", function()
            CopyToClipboard(text)
            sendBigWhiteNotification("📋 Copied!")
        end)
        createContextMenuBtn("🗑️ Delete Message", function()
            deleteFirebaseData("servers/" .. SERVER_KEY .. "/messages/" .. msgId)
            sendBigWhiteNotification("🗑️ Deleted!")
            if messageFrames[msgId] then
                messageFrames[msgId]:Destroy()
                messageFrames[msgId] = nil
                renderedMessageIds[msgId] = nil
            end
        end)
        createContextMenuBtn("😃 Add Reaction", function()
            targetReactionMsgId = msgId
            ReactionPicker.Position = UDim2.new(0, math.clamp(posX - 60, 0, SrvPage.AbsoluteSize.X - 280), 0, math.clamp(posY - 100, 0, SrvPage.AbsoluteSize.Y - 100))
            ReactionPicker.Visible = true
            ContextMenu.Visible = false
        end)
    else
        createContextMenuBtn("👤 View Profile", function()
            local targetId = getUserIdFromName(sender)
            if targetId then openProfilePopup(targetId, dispName, sender)
            else sendBigWhiteNotification("⚠️ Can't find user's ID") end
        end)
        createContextMenuBtn("🔒 PVT (private msg)", function()
            local targetPlr = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == sender:lower() then targetPlr = p break end
            end
            if targetPlr then
                enterPvtMode(targetPlr)
                CInput:CaptureFocus()
            else
                sendBigWhiteNotification("⚠️ Target not in server!")
            end
        end)
        createContextMenuBtn("📋 Copy Message", function()
            CopyToClipboard(text)
            sendBigWhiteNotification("📋 Copied!")
        end)
        createContextMenuBtn("↩️ Reply", function()
            replyingToMsg = {sender = dispName or sender, text = text}
            ReplyPreviewText.Text = "Replying to " .. (dispName or sender) .. ": " .. text
            ReplyPreviewFrame.Visible = true
            MsgScroll.Size = UDim2.new(1, -6, 1, -72)
            sendBigWhiteNotification("↩️ Replying to " .. (dispName or sender))
            ContextMenu.Visible = false
