local function getUserIdFromName(name)
    if not name then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name:lower() or p.DisplayName:lower() == name:lower() then
            return p.UserId
        end
    end
    return nil
end

local function getFollowerTag(count)
    if count >= 100 then return {title = "[VIP]", color = Color3.fromRGB(255, 215, 0)} end
    if count >= 50 then return {title = "[LEGEND]", color = Color3.fromRGB(255, 0, 0)} end
    if count >= 10 then return {title = "[PREMIUM]", color = Color3.fromRGB(100, 185, 255)} end
    return nil
end

local function getSpecialRank(username, userId)
    if not username then return nil end
    local lowerName = string.lower(username)
    if DYNAMIC_RANKS[lowerName] ~= nil then
        if DYNAMIC_RANKS[lowerName] == false or DYNAMIC_RANKS[lowerName].title == "[MEMBER]" or DYNAMIC_RANKS[lowerName].title == "NONE" then
            return nil
        end
        return DYNAMIC_RANKS[lowerName]
    end
    if SPECIAL_RANKS[lowerName] then return SPECIAL_RANKS[lowerName] end
    if not userId then userId = getUserIdFromName(username) end
    if userId and FollowerCache[userId] then
        local tag = getFollowerTag(FollowerCache[userId])
        if tag then return tag end
    end
    return nil
end

