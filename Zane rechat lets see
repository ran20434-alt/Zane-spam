                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🗑️ Director removed rank from @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🗑️ Rank removed from " .. targetUser)
            end
            return
        elseif lowerTxt:sub(1, 9) == "temprank " then
            local args = {} for w in txt:gmatch("%S+") do table.insert(args, w) end
            local targetUser = args[2]
            local durationStr = args[3]
            local rankTitle = table.concat(args, " ", 4)
            if not targetUser or not durationStr or rankTitle == "" then
                addSys("❌ Usage: temprank <user> <duration> <rank>\nDurations: 30s, 5m, 2h, 7d")
                return
            end
            local num, unit = durationStr:match("^(%d+)([smhd])$")
            if not num then addSys("❌ Invalid duration. Use: 30s, 5m, 2h, 7d") return end
            local mult = ({s=1, m=60, h=3600, d=86400})[unit]
