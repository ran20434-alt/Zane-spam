        createContextMenuBtn("😃 Add Reaction", function()
            targetReactionMsgId = msgId
            ReactionPicker.Position = UDim2.new(0, math.clamp(posX - 60, 0, SrvPage.AbsoluteSize.X - 280), 0, math.clamp(posY - 100, 0, SrvPage.AbsoluteSize.Y - 100))
            ReactionPicker.Visible = true
            ContextMenu.Visible = false
        end)
    end

    ContextMenu.Visible = true
end

