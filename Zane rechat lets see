local function renderLeaderboard()
    for _, child in ipairs(LeaderboardScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
    task.spawn(function()
        local allFollowers = getFirebaseData("followers")
        local entries = {}
        if allFollowers and type(allFollowers) == "table" then
            for uid, followersList in pairs(allFollowers) do
                if type(followersList) == "table" then
                    local count = 0
                    for _ in pairs(followersList) do count = count + 1 end
                    if count > 0 then
                        local numId = tonumber(uid)
                        if numId then
                            FollowerCache[numId] = count
                            table.insert(entries, {uid = numId, count = count})
                        end
                    end
                end
            end
        end
        table.sort(entries, function(a, b) return a.count > b.count end)
        if #entries == 0 then
            local empty = Instance.new("TextLabel")
            empty.Size = UDim2.new(1, 0, 0, 40)
            empty.BackgroundTransparency = 1
            empty.Text = "No followers yet — be the first to follow someone!"
            empty.TextColor3 = C.GRAY
            empty.Font = Enum.Font.Gotham
            empty.TextSize = 11
            empty.Parent = LeaderboardScroll
            return
        end
        for rank, entry in ipairs(entries) do
            if rank > 30 then break end
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -4, 0, 46)
            row.BackgroundColor3 = C.BG2
            row.ZIndex = 503
            row.Parent = LeaderboardScroll
            corner(row, 8)
            stroke(row, C.WINOUT, 1)

            local rankLbl = Instance.new("TextLabel")
            rankLbl.Size = UDim2.new(0, 30, 1, 0)
            rankLbl.Position = UDim2.new(0, 4, 0, 0)
            rankLbl.BackgroundTransparency = 1
            rankLbl.Text = "#" .. rank
            rankLbl.TextColor3 = rank == 1 and Color3.fromRGB(255, 200, 0) or rank == 2 and Color3.fromRGB(200, 200, 200) or rank == 3 and Color3.fromRGB(200, 130, 60) or C.GRAY
            rankLbl.Font = Enum.Font.GothamBold
            rankLbl.TextSize = 12
            rankLbl.ZIndex = 504
            rankLbl.Parent = row

            local avatarBtn = Instance.new("TextButton")
            avatarBtn.Size = UDim2.new(0, 34, 0, 34)
            avatarBtn.Position = UDim2.new(0, 38, 0.5, -17)
            avatarBtn.BackgroundColor3 = C.BG3
            avatarBtn.Text = ""
            avatarBtn.ZIndex = 504
            avatarBtn.Parent = row
            corner(avatarBtn, 17)

            local avatarImg = Instance.new("ImageLabel")
            avatarImg.Size = UDim2.new(1, 0, 1, 0)
            avatarImg.BackgroundTransparency = 1
            avatarImg.ZIndex = 505
            avatarImg.Parent = avatarBtn
            corner(avatarImg, 17)
            task.spawn(function()
                local pfp = getUserPFP(entry.uid)
                if pfp then avatarImg.Image = pfp
                else
                    pcall(function()
                        local thumb = Players:GetUserThumbnailAsync(entry.uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                        if thumb then avatarImg.Image = thumb end
                    end)
                end
            end)

            avatarBtn.MouseButton1Click:Connect(function()
                task.spawn(function()
                    local name = "User " .. tostring(entry.uid)
                    pcall(function()
                        local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(entry.uid) end)
                        if ok and n then name = n end
                    end)
                    openProfilePopup(entry.uid, name, name)
                end)
            end)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -220, 0, 16)
            nameLbl.Position = UDim2.new(0, 78, 0, 8)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = "User " .. tostring(entry.uid)
            nameLbl.TextColor3 = C.WHITE
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 11
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.ZIndex = 504
            nameLbl.Parent = row

            local tagLbl = Instance.new("TextLabel")
            tagLbl.Size = UDim2.new(1, -220, 0, 12)
            tagLbl.Position = UDim2.new(0, 78, 0, 26)
            tagLbl.BackgroundTransparency = 1
            tagLbl.Text = entry.count .. " followers"
            tagLbl.TextColor3 = C.GRAY
            tagLbl.Font = Enum.Font.Gotham
            tagLbl.TextSize = 9
            tagLbl.TextXAlignment = Enum.TextXAlignment.Left
            tagLbl.ZIndex = 504
            tagLbl.Parent = row

            task.spawn(function()
                local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(entry.uid) end)
                if ok and name then nameLbl.Text = name end
                local tag = getFollowerTag(entry.count)
                if tag then
                    tagLbl.Text = tag.title .. " • " .. entry.count .. " followers"
                    tagLbl.TextColor3 = tag.color or C.GRAY
                end
            end)

            if entry.uid ~= UserId then
                local followBtn = Instance.new("TextButton")
                followBtn.Size = UDim2.new(0, 80, 0, 26)
                followBtn.Position = UDim2.new(1, -86, 0.5, -13)
                followBtn.Font = Enum.Font.GothamBold
                followBtn.TextSize = 10
                followBtn.ZIndex = 504
                followBtn.Parent = row
                corner(followBtn, 6)

                local function updateBtn()
                    if isFollowing(entry.uid) then
                        followBtn.Text = "✓ Following"
                        followBtn.BackgroundColor3 = C.BG3
                        followBtn.TextColor3 = C.WHITE
                    else
                        followBtn.Text = "+ Follow"
                        followBtn.BackgroundColor3 = C.ACCENT
                        followBtn.TextColor3 = C.WHITE
                    end
                end
                updateBtn()

                followBtn.MouseButton1Click:Connect(function()
                    if isFollowing(entry.uid) then
                        unfollowUser(entry.uid)
                        sendBigWhiteNotification("Unfollowed user " .. tostring(entry.uid))
                    else
                        followUser(entry.uid)
                        sendBigWhiteNotification("Followed user " .. tostring(entry.uid))
                    end
                    updateBtn()
                    entry.count = FollowerCache[entry.uid] or 0
                    tagLbl.Text = entry.count .. " followers"
                end)
            else
                local youLbl = Instance.new("TextLabel")
                youLbl.Size = UDim2.new(0, 80, 0, 26)
                youLbl.Position = UDim2.new(1, -86, 0.5, -13)
                youLbl.BackgroundTransparency = 1
                youLbl.Text = "You"
                youLbl.TextColor3 = C.ACCENT
                youLbl.Font = Enum.Font.GothamBold
                youLbl.TextSize = 10
                youLbl.ZIndex = 504
                youLbl.Parent = row
            end
        end
    end)
end

