local function musicHttpGet(url)
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
    if ok and res and res.Body and #res.Body > 0 then return res.Body end
    return nil
end

local function musicJsonDecode(str)
    if not str or str == "" then return nil end
    local ok, dec = pcall(function() return HttpService:JSONDecode(str) end)
    if ok then return dec end
    return nil
end

local function musicUrlEncode(s)
    return s:gsub("([^%w%-%.%_%~])", function(c) return string.format("%%%02X", c:byte()) end)
end

local function musicStartDownload(ytUrl)
    local id, err = nil, nil
    for ki = musicKeyIndex, #musicApiKeys do
        local key = musicApiKeys[ki]
        local apiUrl = "https://p.savenow.to/ajax/download.php?url=" .. musicUrlEncode(ytUrl) .. "&format=mp3&apikey=" .. key .. "&add_info=1&allow_extended_duration=1&no_merge=0"
        local body = musicHttpGet(apiUrl)
        local data = body and musicJsonDecode(body)
        if data and data.id then
            musicKeyIndex = ki
            id = data.id
            break
        end
        err = (data and data.error) or "No response"
        task.wait(0.3)
    end
    return id, err
end

local function musicPollProgress(id, onProgress)
    local deadline = tick() + 300
    while tick() < deadline do
        local body = musicHttpGet("https://p.savenow.to/ajax/progress.php?id=" .. tostring(id))
        local data = body and musicJsonDecode(body)
        if data then
            local raw = tonumber(data.progress) or 0
            local pct = raw > 100 and math.floor(raw / 10) or math.floor(raw)
            pct = math.clamp(pct, 0, 100)
            if onProgress then onProgress(pct) end
            if raw >= 1000 and data.download_url then return data.download_url, data end
            if data.error and data.error ~= "" then return nil, data.error end
        end
        task.wait(1.5)
    end
    return nil, "Timeout"
end

local function musicSaveFile(url, name)
    if not isfolder(musicFolder) then makefolder(musicFolder) end
    local body = musicHttpGet(url)
    if body then
        local path = musicFolder .. name .. ".mp3"
        writefile(path, body)
        return true, path
    end
    return false, "Download failed"
end

