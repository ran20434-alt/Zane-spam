local function renderProfileList(uid, mode)
    for _, child in ipairs(ProfileListScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
    ProfileListTitle.Text = (mode == "followers") and "Followers" or "Following"

    local loading = Instance.new("TextLabel", ProfileListScroll)
    loading.Size = UDim2.new(1, 0, 0, 36)
    loading.BackgroundTransparency = 1
    loading.Text = "Loading..."
    loading.TextColor3 = C.GRAY
    loading.Font = Enum.Font.Gotham
    loading.TextSize = 11
    loading.ZIndex = 662

    task.spawn(function()
        local listData = getFirebaseData((mode == "followers" and "followers/" or "following/") .. tostring(uid))
        if loading and loading.Parent then loading:Destroy() end

        local ids = {}
        if listData and type(listData) == "table" then
            for k in pairs(listData) do
                local numId = tonumber(k)
                if numId then table.insert(ids, numId) end
            end
        end

        if #ids == 0 then
            local empty = Instance.new("TextLabel", ProfileListScroll)
            empty.Size = UDim2.new(1, 0, 0, 40)
            empty.BackgroundTransparency = 1
            empty.Text = (mode == "followers") and "No followers yet." or "Not following anyone yet."
            empty.TextColor3 = C.GRAY
            empty.Font = Enum.Font.Gotham
            empty.TextSize = 11
            empty.ZIndex = 662
            return
        end

        for _, targetId in ipairs(ids) do
            local row = Instance.new("TextButton", ProfileListScroll)
            row.Size = UDim2.new(1, -4, 0, 48)
            row.BackgroundColor3 = C.BG2
            row.Text = ""
            row.BorderSizePixel = 0
            row.ZIndex = 662
            corner(row, 10)

            local av = Instance.new("ImageLabel", row)
            av.Size = UDim2.new(0, 34, 0, 34)
            av.Position = UDim2.new(0, 8, 0.5, -17)
            av.BackgroundColor3 = C.BG3
            av.ZIndex = 663
            corner(av, 17)
            task.spawn(function()
                local pfp = getUserPFP(targetId)
                if pfp then av.Image = pfp
                else
                    pcall(function()
                        local thumb = Players:GetUserThumbnailAsync(targetId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                        if thumb and av and av.Parent then av.Image = thumb end
                    end)
                end
            end)

            local nLbl = Instance.new("TextLabel", row)
            nLbl.Size = UDim2.new(1, -60, 1, 0)
            nLbl.Position = UDim2.new(0, 50, 0, 0)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = "User " .. tostring(targetId)
            nLbl.TextColor3 = C.WHITE
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextSize = 12
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.ZIndex = 663

            task.spawn(function()
                local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(targetId) end)
                if ok and n and nLbl and nLbl.Parent then nLbl.Text = n end
            end)

            row.MouseButton1Click:Connect(function()
                task.spawn(function()
                    local name = "User " .. tostring(targetId)
                    pcall(function()
                        local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(targetId) end)
                        if ok and n then name = n end
                    end)
                    slideOut(ProfileListCard, function() openProfilePopup(targetId, name, name) end)
                end)
            end)
        end
    end)
end

