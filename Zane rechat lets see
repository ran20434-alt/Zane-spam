local function slideOut(frame, onDone)
    TweenSvc:Create(frame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(Win.Position.X.Scale, Win.Position.X.Offset + PROFILE_OFFSET, Win.Position.Y.Scale, Win.Position.Y.Offset)
    }):Play()
    task.delay(0.2, function()
        frame.Visible = false
        if onDone then onDone() end
    end)
end

