def is_jannat_type(user):
    n = user.name.lower() + " " + user.display_name.lower()
    return "jannat" in n

async def _send_image(message, prompt: str):
    if not prompt:
        await message.reply("Kya banau jaan? Prompt de do 🎨")
        return
    await message.reply(f"🎨 Banaya ja raha hai: **{prompt}** ...")
    encoded = urllib.parse.quote(prompt)
    url = f"https://image.pollinations.ai/prompt/{encoded}?width=768&height=768&nologo=true"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=60) as resp:
                if resp.status == 200:
                    data = await resp.read()
                    await message.channel.send(
                        file=discord.File(io.BytesIO(data), filename="nark_art.png")
                    )
                else:
                    await message.channel.send("Image nahi ban payi 😔, thodi der baad try karo.")
    except Exception as e:
        await message.channel.send(f"Oops 😅 error: `{e}`")

