        if clean.startswith("imagine ") or clean.startswith("image "):
            await _send_image(message, clean.split(" ", 1)[1].strip())
            return
        if clean.startswith("roast"):
            mentioned = [m for m in message.mentions if m.id != bot.user.id]
            if mentioned:
                target = mentioned[0]
                if is_jannat_type(target) or "zane" in target.name.lower():
                    await message.reply("Boss, unko roast nahi kar sakta 🙏")
