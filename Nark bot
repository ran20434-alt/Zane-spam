            return
        if clean.startswith("flirt"):
            mentioned = [m for m in message.mentions if m.id != bot.user.id]
            target = mentioned[0].mention if mentioned else message.author.mention
            await message.channel.send(random.choice(FLIRTY).format(user=target))
