-- Main Sync Loop
task.spawn(function()
    while true do
        syncRanks()
        refreshExistingChatRanks()

        local syncNow = os.time()
        if syncNow - lastGlobalAnnouncementSync >= 2 then
            lastGlobalAnnouncementSync = syncNow
            local globalAnnouncements = getFirebaseData("global_announcements")
            if globalAnnouncements then
                for announcementId, announcement in pairs(globalAnnouncements) do
                    if not processedGlobalAnnouncements[announcementId] then
                        processedGlobalAnnouncements[announcementId] = true
                        if tonumber(announcement.timestamp or 0) >= sessionStartTime then
                            addSys(announcement.Content or announcement.Text or "📢 Global announcement")
                        end
                    end
                end
            end
        end

        local muteData = getFirebaseData("servers/" .. SERVER_KEY .. "/mutes")
        GlobalMutedUsers = {}
        if muteData then
            for mutedUser, muteInfo in pairs(muteData) do
                if type(muteInfo) == "table" and muteInfo.muted == true then
                    GlobalMutedUsers[string.lower(mutedUser)] = true
                end
            end
        end

        local adminEvents = getFirebaseData("servers/" .. SERVER_KEY .. "/admin_events")
        if adminEvents then
            for eventId, event in pairs(adminEvents) do
                if not processedAdminEvents[eventId] then
                    processedAdminEvents[eventId] = true
                    local eventTime = tonumber(event.timestamp or 0) or 0
                    local eventTarget = string.lower(tostring(event.target or "")):gsub("^@", "")
                    if eventTime >= sessionStartTime and eventTarget == string.lower(PlayerName) and event.action == "kick" then
                        Player:Kick("👢 You were kicked by the Director. " .. tostring(event.reason or ""))
                    end
                end
            end
        end

        if not isDirectorUser(PlayerName) then
            local banCheckLive = getFirebaseData("bans/" .. PlayerName:lower())
            if banCheckLive and banCheckLive.banned then
                Player:Kick("🔨 You are banned by Staff " .. (banCheckLive.by or "Staff") .. ". Reason: " .. (banCheckLive.reason or "Banned"))
            end
        end

        local data = getFirebaseData("servers/" .. SERVER_KEY .. "/messages")
        if data then
            for id, frame in pairs(messageFrames) do
                if not data[id] then
                    if frame and frame.Parent then frame:Destroy() end
                    messageFrames[id] = nil
                    renderedMessageIds[id] = nil
                    messageTextLabels[id] = nil
                end
            end

            for id, msg in pairs(data) do
                if not processedMessages[id] then
                    processedMessages[id] = true
                    if msg.timestamp and msg.timestamp >= sessionStartTime then
                        if (msg.Sender or msg.sender) ~= PlayerName then
                            renderMessageItem(msg, id)
                        end
                    end
                else
                    if messageFrames[id] then
                        local msgContent = messageFrames[id]:FindFirstChild("Frame")
                        local bub = msgContent and msgContent:FindFirstChild("Frame")
                        if bub then
                            local rx = bub:FindFirstChild("ReactionLabel")
                            if rx and msg.reaction then
                                rx.Text = msg.reaction
                            end
                        end
                    end
                end
            end
        end

        local socialNotifications = getFirebaseData("social/notifications/" .. socialUserKey(UserId))
        if socialNotifications then
            for notificationId, notification in pairs(socialNotifications) do
                if not processedSocialNotifications[notificationId] then
                    processedSocialNotifications[notificationId] = true
                    if notification.type == "follow" then
                        addSys("👥 @" .. tostring(notification.fromUsername or notification.fromDisplayName or "Someone") .. " started following you!")
                    end
                end
            end
        end

        if isInitialLoad then
            isInitialLoad = false
        end

        local musicData = getFirebaseData("servers/" .. SERVER_KEY .. "/global_music")
        if musicData and musicData.audioId then
            local musicToken = tostring(musicData.audioId) .. ":" .. tostring(musicData.timestamp or "")
            if musicToken ~= lastPlayedMusicToken then
                lastPlayedMusicToken = musicToken
                if tostring(musicData.audioId) == "0" then
                    globalSound:Stop()
                else
                    globalSound:Stop()
                    globalSound.SoundId = "rbxassetid://" .. tostring(musicData.audioId)
                    globalSound.TimePosition = 0
                    globalSound:Play()
                end
            end
        end

        local volData = getFirebaseData("servers/" .. SERVER_KEY .. "/global_volume")
        if volData and volData.volume and currentGlobalVolume ~= volData.volume then
            currentGlobalVolume = volData.volume
            globalSound.Volume = currentGlobalVolume
            soundGroup.Volume = currentGlobalVolume
        end

        task.wait(0.01)
    end
end)
