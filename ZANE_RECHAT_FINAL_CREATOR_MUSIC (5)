-- Followers / Following system
local function socialUserKey(userId)
    return tostring(math.floor(tonumber(userId) or 0))
end

function findOnlinePlayer(name)
    if not name or name == "" then return nil end
    local query = name:lower():gsub("^@", "")
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower() == query or player.DisplayName:lower() == query then
            return player
        end
    end
    return nil
end

local function getSocialList(kind, userId)
    return getFirebaseData("social/" .. kind .. "/" .. socialUserKey(userId)) or {}
end

local function getSocialCount(kind, userId)
    local entries = getSocialList(kind, userId)
    local count = 0
    for _ in pairs(entries) do
        count = count + 1
    end
    return count
end

local function getFollowerCount(userId)
    return getSocialCount("followers", userId)
end

local function isFollowing(userId)
    local entry = getFirebaseData("social/following/" .. socialUserKey(UserId) .. "/" .. socialUserKey(userId))
    return type(entry) == "table" and next(entry) ~= nil
end

local function getFollowerRank(count)
    if count >= 100 then return "[VIP]" end
    if count >= 50 then return "[LEGEND]" end
    if count >= 10 then return "[PREMIUM]" end
    return "[MEMBER]"
end

local GLOBAL_SOCIAL_USERS_PATH = "social/global_users"

local function refreshFollowerTagCache()
    local globalData = getFirebaseData(GLOBAL_SOCIAL_USERS_PATH) or {}
    for userId, profile in pairs(globalData) do
        if type(profile) == "table" then
            local numericId = tonumber(profile.userId or userId)
            if numericId then
                local followerCount = tonumber(profile.followerCount) or 0
                FollowerTagCache[numericId] = getFollowerRank(followerCount)
            end
        end
    end
end

task.spawn(function()
    refreshFollowerTagCache()
    while task.wait(15) do
        refreshFollowerTagCache()
    end
end)

local function syncGlobalSocialProfile(target)
    if not target or not target.UserId then return end
    local followerCount = getFollowerCount(target.UserId)
    local followingCount = getSocialCount("following", target.UserId)
    FollowerTagCache[target.UserId] = getFollowerRank(followerCount)
    putFirebaseData(GLOBAL_SOCIAL_USERS_PATH .. "/" .. socialUserKey(target.UserId), {
        userId = target.UserId,
        username = target.Name,
        displayName = target.DisplayName,
        followerCount = followerCount,
        followingCount = followingCount,
        rank = getFollowerRank(followerCount),
        lastSeen = os.time()
    })
end

-- Register every user who runs the script in the worldwide social index,
-- even if they never open the leaderboard tab.
task.spawn(syncGlobalSocialProfile, {UserId = UserId, Name = PlayerName, DisplayName = DisplayName})

function followPlayer(target)
    if not target or target.UserId == UserId then return false, "You cannot follow yourself." end
    local follower = {
        userId = UserId,
        username = PlayerName,
        displayName = DisplayName,
        timestamp = os.time()
    }
    local following = {
        userId = target.UserId,
        username = target.Name,
        displayName = target.DisplayName,
        timestamp = os.time()
    }
    putFirebaseData("social/following/" .. socialUserKey(UserId) .. "/" .. socialUserKey(target.UserId), following)
    putFirebaseData("social/followers/" .. socialUserKey(target.UserId) .. "/" .. socialUserKey(UserId), follower)
    sendFirebaseData("social/notifications/" .. socialUserKey(target.UserId), {
        type = "follow",
        fromUserId = UserId,
        fromUsername = PlayerName,
        fromDisplayName = DisplayName,
        timestamp = os.time()
    })
    task.spawn(syncGlobalSocialProfile, target)
    task.spawn(syncGlobalSocialProfile, {UserId = UserId, Name = PlayerName, DisplayName = DisplayName})
    return true, "Now following @" .. target.Name .. "."
end

local function unfollowPlayer(target)
    if not target or target.UserId == UserId then return false, "Invalid follow target." end
    deleteFirebaseData("social/following/" .. socialUserKey(UserId) .. "/" .. socialUserKey(target.UserId))
    deleteFirebaseData("social/followers/" .. socialUserKey(target.UserId) .. "/" .. socialUserKey(UserId))
    task.spawn(syncGlobalSocialProfile, target)
    task.spawn(syncGlobalSocialProfile, {UserId = UserId, Name = PlayerName, DisplayName = DisplayName})
    return true, "Unfollowed @" .. target.Name .. "."
end

