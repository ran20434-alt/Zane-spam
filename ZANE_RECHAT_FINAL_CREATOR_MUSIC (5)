local function showHeadBubble(senderIdentifier, text)
    if not text or text == "" then return end
    local targetPlr = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == senderIdentifier:lower() or p.DisplayName:lower() == senderIdentifier:lower() or tostring(p.UserId) == tostring(senderIdentifier) then
            targetPlr = p
            break
