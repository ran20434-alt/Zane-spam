            empty.Font = Enum.Font.Gotham
            empty.Parent = MusicLibrary
            return
        end
        local count = 0
        for _, path in ipairs(listfiles(creatorMusicFolder)) do
            if path:lower():match("%.mp3$") then
                count = count + 1
                local title = path:match("[^\\/]+$") or path
                local playButton = Instance.new("TextButton")
