    task.defer(refreshCreatorLibrary)

    MusicVolume.FocusLost:Connect(function(enterPressed)
        if not enterPressed then return end
        local volume = tonumber(MusicVolume.Text)
        if not volume then
            MusicVolume.Text = tostring(creatorMusic.volume)
            return
        end
        volume = math.clamp(volume, 0, 1)
        MusicVolume.Text = tostring(volume)
        creatorMusic.volume = volume
        if creatorMusic.sound then creatorMusic.sound.Volume = volume end
        MusicStatus.Text = "Local volume set to " .. tostring(volume) .. "."
    end)
