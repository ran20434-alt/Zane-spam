                creatorMusic.playing = false
                MusicPlay.Text = "▶ Resume"
                MusicStatus.Text = "Paused"
            else
                creatorMusic.sound:Play()
                creatorMusic.playing = true
                MusicPlay.Text = "⏸ Pause"
                MusicStatus.Text = "Playing " .. creatorMusic.title
            end
            return
        end
        creatorMusicDownloadYouTube(MusicInput.Text, function(status, detail)
            MusicStatus.Text = status .. (detail ~= "" and " • " .. detail or "")
            if status == "Done!" then MusicPlay.Text = "⏸ Pause" end
        end)
    end)

    MusicStop.MouseButton1Click:Connect(function()
        if creatorMusic.sound then
            creatorMusic.sound:Stop()
            creatorMusic.sound:Destroy()
            creatorMusic.sound = nil
