-- Tapping outside the chat window exits ARES-style private-chat mode.
UIS.InputBegan:Connect(function(input)
    if not privateChatTarget or not Win.Visible then return end
    if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    local p = input.Position
    local topLeft = Win.AbsolutePosition
    local size = Win.AbsoluteSize
    local inside = p.X >= topLeft.X and p.X <= topLeft.X + size.X
        and p.Y >= topLeft.Y and p.Y <= topLeft.Y + size.Y

    if not inside then
        privateChatTarget = nil
        replyingToMsg = nil
        ReplyPreviewFrame.Visible = false
        MsgScroll.Size = UDim2.new(1, -6, 1, -48)
        CInput.PlaceholderText = "Server Chat or /help..."
        addSys("🌐 Public chat enabled. [PVT] tag removed; public rank restored.")
    end
end)

