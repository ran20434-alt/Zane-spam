-- The old separate DMS composer is disabled. Private chat now uses the main
-- ARES-style composer and targeted messages in servers/<server>/messages.

-- Render Message Item
function renderMessageItem(data, msgId)
    if renderedMessageIds[msgId] then return end
    renderedMessageIds[msgId] = true

    local targetId = tonumber(data.TargetId or data.targetUserId or data.TargetUserId)
    local senderId = tonumber(data.SenderUid or data.UserId or data.userId)
    local senderName = data.Sender or data.sender or ""
    if GlobalMutedUsers[string.lower(senderName)] and senderName ~= PlayerName then
        return
    end
    if (data.IsDM or data.isPrivate) and targetId and targetId ~= UserId and senderId ~= UserId then
        return
    end

    local isSystem = (senderName == "SYSTEM" or data.isSys)
    local isSticker = string.find(data.Text or data.message or "", "%[STICKER%]:")
    local isImage = string.find(data.Text or data.message or "", "%[IMAGE%]:") or data.isImg

    if isSystem then
        addSys(data.Text or data.message or "")
    elseif isSticker then
        local assetId = string.gsub(data.Text or data.message or "", "%[STICKER%]:%s*", "")
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, "", MsgScroll, true, assetId, data.UserId or data.userId, msgId)
    elseif isImage then
        local imgUrl = data.imgUrl or string.gsub(data.Text or data.message or "", "%[IMAGE%]:%s*", "")
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, "", MsgScroll, true, imgUrl, data.UserId or data.userId, msgId)
    else
        local textVal = data.Text or data.message or ""
        addMsg(data.Sender or data.sender, data.DisplayName or data.displayName or data.Sender or data.sender, textVal, MsgScroll, false, nil, data.UserId or data.userId, msgId, data.replyData or data.ReplyTo, data.reaction, data.isPrivate or data.IsDM)
    end

    if not isInitialLoad and (data.Sender or data.sender) ~= PlayerName then
        sendBigWhiteNotification("📩 New message from " .. (data.DisplayName or data.displayName or data.Sender or data.sender))
    end
end

-- Send Message Function
local function sendMsg() 
    local txt = CInput.Text 
    if txt == "" then return end 
    CInput.Text = "" 

    local lowerTxt = txt:lower()

    if lowerTxt == "/public" or lowerTxt == "/exitpvt" then
        privateChatTarget = nil
        replyingToMsg = nil
        ReplyPreviewFrame.Visible = false
        MsgScroll.Size = UDim2.new(1, -6, 1, -48)
        CInput.PlaceholderText = "Server Chat or /help..."
        addSys("🌐 Public chat enabled. [PVT] tag removed; public rank restored.")
        return
    end

    local profileTargetName = lowerTxt:sub(1, 9) == "/profile " and txt:sub(10) or nil
    if lowerTxt:sub(1, 9) == "/profile " and profileTargetName then
        local target = findOnlinePlayer(profileTargetName)
        if target then showSocialProfile(target) else addSys("❌ Player not found in this server.") end
        return
    end

    local followTargetName = lowerTxt:sub(1, 8) == "/follow " and txt:sub(9) or nil
    if lowerTxt:sub(1, 8) == "/follow " and followTargetName then
        local target = findOnlinePlayer(followTargetName)
        if not target then
            addSys("❌ Player not found in this server.")
        else
            local ok, message = followPlayer(target)
            addSys((ok and "✅ " or "❌ ") .. message)
            if LeaderboardPage.Visible then task.delay(0.25, refreshLeaderboard) end
        end
        return
    end

    local unfollowTargetName = lowerTxt:sub(1, 10) == "/unfollow " and txt:sub(11) or nil
    if lowerTxt:sub(1, 10) == "/unfollow " and unfollowTargetName then
        local target = findOnlinePlayer(unfollowTargetName)
        if not target then
            addSys("❌ Player not found in this server.")
        else
            local ok, message = unfollowPlayer(target)
            addSys((ok and "✅ " or "❌ ") .. message)
            if LeaderboardPage.Visible then task.delay(0.25, refreshLeaderboard) end
        end
        return
    end

    if lowerTxt == "/followers" or lowerTxt == "/following" then
        local kind = lowerTxt == "/followers" and "followers" or "following"
        local title = kind == "followers" and "Followers" or "Following"
        task.spawn(function()
            local socialList = getSocialList(kind, UserId)
            local names = {}
            for _, data in pairs(socialList) do
                if type(data) == "table" then
                    table.insert(names, "@" .. tostring(data.username or data.displayName or "Unknown"))
                end
            end
            table.sort(names)
            if #names == 0 then
                addSys("👥 " .. title .. ": none yet.")
            else
                addSys("👥 " .. title .. " (" .. #names .. "): " .. table.concat(names, ", "))
            end
        end)
        return
    end

    if lowerTxt == "/stopmusic" or lowerTxt == "/stop" then
        if hasElevatedCommandAccess(PlayerName) then
            putFirebaseData("servers/" .. SERVER_KEY .. "/global_music", {audioId = "0", playedBy = PlayerName, timestamp = os.time()})
            globalSound:Stop()
            addSys("🔇 Server music stopped.")
        else
            addSys("❌ You don't have permission to stop music!")
        end
        return
    end

    if lowerTxt == "/help" then
        addSys("📋 ZaNe Server Commands:\n• /help - Show command list\n• /profile <name> - View profile\n• /follow <name> - Follow a player\n• /unfollow <name> - Unfollow a player\n• /followers - Show your followers\n• /following - Show who you follow\n• /public or /exitpvt - Return to public chat\n• /stop or /stopmusic - Stop server audio (Elevated)\n• /w <user> <msg> - One-off private message\n• /announce <msg> (Director Only)\n• /temprank <user> <title> <minutes> (Director Only)\n• /removetemprank <user> (Director Only)\n• /kick <user> [reason] (Director Only)\n• /ban <user> [reason] (Director Only)\n• /unban <user> (Director Only)\n• /mute <user> (Director Only)\n• /unmute <user> (Director Only)\n• /tp2, /to, /goto <user> (Director Only)\n• /bring <user|all> (Director Only)\n• /clear (Director Only, local chat)\n• setrank <user> <title> (Director Only)\n• removerank <user> (Director Only)\n• play <id> / play 0 (Elevated)\n• volume <0-10> (Elevated)\n• LEADERBOARD tab - Global Top 200, Premium 10+, Legend 50+, VIP 100+")
        return
    end

    if lowerTxt == "/rule" or lowerTxt == "/rules" then
        addSys("📜 Server Rules:\n1. Respect all players\n2. No exploiting or spamming\n3. Staff decisions are final")
        return
    end

    -- GLOBAL ANNOUNCEMENTS AND TEMPORARY RANKS
    if hasElevatedCommandAccess(PlayerName) then
        if lowerTxt:sub(1, 10) == "/announce " then
            if not isDirectorUser(PlayerName) then
                addSys("❌ Only the Director can send global announcements.")
                return
            end
            local announcement = txt:sub(11)
            if announcement ~= "" then
                sendFirebaseData("global_announcements", {
                    Sender = "SYSTEM",
                    Content = "📢 ANNOUNCEMENT: " .. announcement,
                    Text = "📢 ANNOUNCEMENT: " .. announcement,
                    Server = "GLOBAL",
                    IsSystem = true,
                    isSys = true,
                    announcedBy = PlayerName,
                    timestamp = os.time()
                })
                addSys("📢 Global announcement sent!")
            end
            return
        elseif lowerTxt:sub(1, 10) == "/temprank " then
            if not isDirectorUser(PlayerName) then
                addSys("❌ Only the Director can grant temporary ranks.")
                return
            end
            local args = {}
            for word in txt:gmatch("%S+") do table.insert(args, word) end
            local targetUser = args[2]
            local minutes = tonumber(args[#args])
            local rankTitle = (#args >= 4 and table.concat(args, " ", 3, #args - 1) or ""):upper()
            minutes = minutes and math.clamp(math.floor(minutes), 1, 10080) or nil
            if targetUser and minutes and rankTitle ~= "" then
                local expiresAt = os.time() + (minutes * 60)
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {
                    title = "[" .. rankTitle .. "]",
                    type = "rgb",
                    temporary = true,
                    expiresAt = expiresAt,
                    grantedBy = PlayerName,
                    removed = false
                })
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "⭐ Temporary rank [" .. rankTitle .. "] granted to @" .. targetUser .. " for " .. minutes .. " minute(s)", timestamp = os.time(), isSys = true})
                addSys("✅ Temporary rank granted to @" .. targetUser .. " for " .. minutes .. " minute(s).")
            else
                addSys("❌ Usage: /temprank <user> <title> <minutes>")
            end
            return
        elseif lowerTxt:sub(1, 16) == "/removetemprank " then
            if not isDirectorUser(PlayerName) then
                addSys("❌ Only the Director can remove temporary ranks.")
                return
            end
            local targetUser = txt:sub(17):match("%S+")
            if targetUser then
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {title = "NONE", removed = true, removedBy = PlayerName, timestamp = os.time()})
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🗑️ Temporary rank removed from @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🗑️ Temporary rank removed from @" .. targetUser)
            end
            return
        end
    end

    -- DIRECTOR-ONLY RANK MANAGEMENT
    if isDirectorUser(PlayerName) then
        if lowerTxt:sub(1, 9) == "setrank " then
            local args = {} for w in txt:gmatch("%S+") do table.insert(args, w) end
            local targetUser = args[2]
            local rankTitle = table.concat(args, " ", 3)
            if targetUser and rankTitle ~= "" then
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {title = "[" .. rankTitle:upper() .. "]", type = "rgb", removed = false})
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "⭐ Director assigned rank [" .. rankTitle:upper() .. "] to @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("✅ Rank [" .. rankTitle:upper() .. "] assigned to " .. targetUser)
            end
            return
        elseif lowerTxt:sub(1, 12) == "removerank " then
            local targetUser = txt:sub(13):match("%S+")
            if targetUser then
                putFirebaseData("dynamic_ranks/" .. targetUser:lower(), {title = "NONE", removed = true})
                syncRanks()
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🗑️ Director removed rank from @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🗑️ Rank removed from " .. targetUser)
            end
            return
        end
    end

    -- ARES-style moderation commands: Director only.
    local adminCommand = lowerTxt:gsub("^/", "")
    if adminCommand:sub(1, 5) == "kick " or adminCommand:sub(1, 6) == "unban " or adminCommand:sub(1, 7) == "unmute " or adminCommand == "clear" or adminCommand:sub(1, 5) == "mute " or adminCommand:sub(1, 4) == "ban " or adminCommand:sub(1, 5) == "tp2 " or adminCommand:sub(1, 4) == "to " or adminCommand:sub(1, 6) == "goto " or adminCommand:sub(1, 6) == "bring " then
        if not directorOnly() then return end
        local args = {}
        for word in txt:gmatch("%S+") do table.insert(args, word) end
        local targetUser = moderationTarget(args)

        if adminCommand == "clear" then
            for id, frame in pairs(messageFrames) do
                if frame and frame.Parent then frame:Destroy() end
                messageFrames[id] = nil
                renderedMessageIds[id] = nil
                messageTextLabels[id] = nil
            end
            addSys("🧹 Chat cleared locally for you.")
            return
        end

        local isTeleportCommand = adminCommand:sub(1, 5) == "tp2 " or adminCommand:sub(1, 4) == "to " or adminCommand:sub(1, 6) == "goto " or adminCommand:sub(1, 6) == "bring "
        if isTeleportCommand then
            if not targetUser then
                addSys("❌ Usage: /tp2 <username>, /to <username>, /goto <username>, or /bring <username|all>")
                return
            end
            local myRoot = getRootPart(Player.Character)
            if not myRoot then
                addSys("❌ Your character is not ready.")
                return
            end

            if adminCommand:sub(1, 6) == "bring " and targetUser:lower() == "all" then
                local moved = 0
                for _, targetPlayer in ipairs(Players:GetPlayers()) do
                    if targetPlayer ~= Player and not isProtectedDirector(targetPlayer.Name) and targetPlayer.Character then
                        if teleportCharacter(targetPlayer.Character, myRoot.CFrame * CFrame.new(0, 0, -4 - (moved * 3))) then
                            moved = moved + 1
                        end
                    end
                end
                addSys("📍 Brought " .. moved .. " player(s) to you locally.")
                return
            end

            local targetPlayer = findOnlinePlayer(targetUser)
            if not targetPlayer or not targetPlayer.Character then
                addSys("❌ Player not found or character is not ready: " .. targetUser)
                return
            end
            local targetRoot = getRootPart(targetPlayer.Character)
            if not targetRoot then
                addSys("❌ Target character has no root part.")
                return
            end

            if adminCommand:sub(1, 6) == "bring " then
                if isProtectedDirector(targetPlayer.Name) then
                    addSys("🛡️ Directors are protected from bring commands.")
                    return
                end
                teleportCharacter(targetPlayer.Character, myRoot.CFrame * CFrame.new(0, 0, -4))
                addSys("📍 Brought @" .. targetPlayer.Name .. " to you locally.")
            else
                teleportCharacter(Player.Character, targetRoot.CFrame * CFrame.new(0, 0, -4))
                addSys("📍 Teleported to @" .. targetPlayer.Name .. ".")
            end
            return
        end

        if not targetUser then
            addSys("❌ Usage: /kick, /ban, /unban, /mute, or /unmute <username> [reason]")
            return
        end
        if targetUser:lower() == PlayerName:lower() then
            addSys("❌ You cannot use this command on yourself.")
            return
        end
        if isProtectedDirector(targetUser) then
            addSys("🛡️ Action blocked: Directors are protected from moderation commands.")
            return
        end

        if adminCommand:sub(1, 5) == "kick " then
            local reason = table.concat(args, " ", 3)
            publishAdminEvent("kick", targetUser, reason ~= "" and reason or "Kicked by Director")
            sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "👢 Director kicked @" .. targetUser, timestamp = os.time(), isSys = true})
            addSys("👢 Kick command sent to @" .. targetUser)
        elseif adminCommand:sub(1, 4) == "ban " then
            local reason = table.concat(args, " ", 3)
            putFirebaseData("bans/" .. targetUser:lower(), {banned = true, reason = reason ~= "" and reason or "Banned by Director", by = PlayerName, timestamp = os.time()})
            publishAdminEvent("kick", targetUser, reason ~= "" and reason or "Banned by Director")
            sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔨 Director permanently banned @" .. targetUser, timestamp = os.time(), isSys = true})
            addSys("🔨 Ban applied to @" .. targetUser)
        elseif adminCommand:sub(1, 6) == "unban " then
            deleteFirebaseData("bans/" .. targetUser:lower())
            addSys("🔓 @" .. targetUser .. " has been unbanned.")
        elseif adminCommand:sub(1, 5) == "mute " then
            putFirebaseData("servers/" .. SERVER_KEY .. "/mutes/" .. targetUser:lower(), {muted = true, by = PlayerName, timestamp = os.time()})
            GlobalMutedUsers[targetUser:lower()] = true
            addSys("🔇 @" .. targetUser .. " is now muted globally.")
        elseif adminCommand:sub(1, 7) == "unmute " then
            deleteFirebaseData("servers/" .. SERVER_KEY .. "/mutes/" .. targetUser:lower())
            GlobalMutedUsers[targetUser:lower()] = nil
            addSys("🔊 @" .. targetUser .. " has been unmuted globally.")
        end
        return
    end

    -- CREATOR, DIRECTOR, AND NAMED ELEVATED COMMAND USERS
    if hasElevatedCommandAccess(PlayerName) then
        if lowerTxt:sub(1, 9) == "announce " then
            if not isDirectorUser(PlayerName) then
                addSys("❌ Only the Director can send announcements.")
                return
            end
            sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "📢 [ANNOUNCEMENT] " .. txt:sub(10), timestamp = os.time(), isSys = true})
            addSys("📢 Announcement sent!")
            return
        elseif lowerTxt:sub(1, 6) == "unban " then
            local targetUser = txt:sub(7):match("%S+")
            if targetUser then
                deleteFirebaseData("bans/" .. targetUser:lower())
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔓 Staff UNBANNED @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🔓 " .. targetUser .. " has been unbanned")
            end
            return
        elseif lowerTxt:sub(1, 4) == "ban " then
            if not hasAdminAccess(PlayerName) then
                addSys("❌ Only directors and admins can ban users.")
                return
            end
            local args = {} for w in txt:gmatch("%S+") do table.insert(args, w) end
            local targetUser = args[2]
            local reason = table.concat(args, " ", 3)
            if targetUser then
                if isDirectorUser(targetUser) then
                    addSys("🛡️ Action blocked: Director ranks are immune to bans!")
                    return
                end
                putFirebaseData("bans/" .. targetUser:lower(), {banned = true, reason = reason ~= "" and reason or "Banned by Staff", by = PlayerName, timestamp = os.time()})
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔨 Staff PERMANENTLY BANNED @" .. targetUser, timestamp = os.time(), isSys = true})
                addSys("🔨 " .. targetUser .. " has been banned")
            end
            return
        end
    end

    -- VOLUME COMMAND - Updated to allow elevated rank users
    if lowerTxt:sub(1, 7) == "volume " or lowerTxt:sub(1, 4) == "vol " then
        local volNum = tonumber(txt:match("%d+"))
        if volNum then
            volNum = math.clamp(volNum, 0, 10)
            if hasElevatedCommandAccess(PlayerName) then
                putFirebaseData("servers/" .. SERVER_KEY .. "/global_volume", {volume = volNum, setBy = PlayerName})
                sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔊 Server Volume set to " .. volNum, timestamp = os.time(), isSys = true})
                addSys("🔊 Volume set to " .. volNum)
            else
                addSys("❌ You don't have permission to change volume! (Volume permission: APEX_SHADOW728, Directors, Creators)")
            end
        end
        return
    end

    -- MUSIC COMMAND - Updated to allow elevated rank users
    if lowerTxt:sub(1, 5) == "play " or lowerTxt:sub(1, 6) == "music " then
        local assetId = txt:match("%d+")
        if assetId then
            if hasElevatedCommandAccess(PlayerName) then
                putFirebaseData("servers/" .. SERVER_KEY .. "/global_music", {audioId = assetId, playedBy = PlayerName, timestamp = os.time()})
                if assetId == "0" then
                    sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🔇 Server Music STOPPED", timestamp = os.time(), isSys = true})
                    addSys("🔇 Music stopped")
                else
                    sendFirebaseData("servers/" .. SERVER_KEY .. "/messages", {Sender = "SYSTEM", Text = "🎵 Playing Audio ID: " .. assetId, timestamp = os.time(), isSys = true})
                    addSys("🎵 Playing music ID: " .. assetId)
                end
            else
                addSys("❌ You don't have permission to play music! (Music permission: APEX_SHADOW728, Directors, Creators)")
            end
        end
        return
    end

    if privateChatTarget then
        local privateReply = replyingToMsg
        replyingToMsg = nil
        ReplyPreviewFrame.Visible = false
        MsgScroll.Size = UDim2.new(1, -6, 1, -48)
        local privatePayload = {
            Sender = PlayerName,
            SenderUid = UserId,
            DisplayName = DisplayName,
            UserId = UserId,
            Content = txt,
            Text = txt,
            Server = SERVER_KEY,
            IsDM = true,
            isPrivate = true,
            TargetId = privateChatTarget.UserId,
            TargetUserId = privateChatTarget.UserId,
            TargetName = privateChatTarget.Name,
            ReplyTo = privateReply,
            replyData = privateReply,
            timestamp = os.time()
        }
        addMsg(PlayerName, DisplayName, txt, MsgScroll, false, nil, UserId, nil, privateReply, nil, true)
        task.spawn(sendFirebaseData, "servers/" .. SERVER_KEY .. "/messages", privatePayload)
        addSys("🔒 Private message sent to @" .. privateChatTarget.Name, Color3.fromRGB(50, 30, 70))
        return
    end

    -- ARES-style targeted private messages
    if lowerTxt:sub(1, 3) == "/w " or lowerTxt:sub(1, 4) == "/pm " then
        local args = {} for word in txt:gmatch("%S+") do table.insert(args, word) end
        local targetName = args[2]
        local pvtMessage = table.concat(args, " ", 3)

        if targetName and pvtMessage and pvtMessage ~= "" then
            local foundTarget = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower() == targetName:lower() or p.DisplayName:lower() == targetName:lower() then
                    foundTarget = p
                    break
                end
            end

            if foundTarget then
                local privateReply = replyingToMsg
                replyingToMsg = nil
                ReplyPreviewFrame.Visible = false
                MsgScroll.Size = UDim2.new(1, -6, 1, -48)
                local payload = {
                    Sender = PlayerName,
                    SenderUid = UserId,
                    DisplayName = DisplayName,
                    UserId = UserId,
                    Content = pvtMessage,
                    Text = pvtMessage,
                    Server = SERVER_KEY,
                    IsDM = true,
                    isPrivate = true,
                    TargetId = foundTarget.UserId,
                    TargetUserId = foundTarget.UserId,
                    TargetName = foundTarget.Name,
                    ReplyTo = privateReply,
                    replyData = privateReply,
                    timestamp = os.time()
                }
                addMsg(PlayerName, DisplayName, pvtMessage, MsgScroll, false, nil, UserId, nil, privateReply, nil, true)
                task.spawn(sendFirebaseData, "servers/" .. SERVER_KEY .. "/messages", payload)
                addSys("🔒 Private message sent to @" .. foundTarget.Name, Color3.fromRGB(50, 30, 70))
            else
                addSys("❌ Player '" .. targetName .. "' not found in server.")
            end
        end
        return
    end

    -- Normal Message with Reply
    local currentReply = replyingToMsg
    replyingToMsg = nil
    ReplyPreviewFrame.Visible = false
    MsgScroll.Size = UDim2.new(1, -6, 1, -48)

    addMsg(PlayerName, DisplayName, txt, MsgScroll, false, nil, UserId, nil, currentReply)

    local payload = {
        Sender = PlayerName,
        SenderUid = UserId,
        DisplayName = DisplayName,
        UserId = UserId,
        Content = txt,
        Text = txt,
        Server = SERVER_KEY,
        IsDM = false,
        TargetId = nil,
        ReplyTo = currentReply,
        replyData = currentReply,
        isPrivate = false,
        timestamp = os.time()
    }
    
    task.spawn(sendFirebaseData, "servers/" .. SERVER_KEY .. "/messages", payload)
end 

