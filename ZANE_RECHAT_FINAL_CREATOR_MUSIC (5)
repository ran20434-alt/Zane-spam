            task.delay(HOLD_TIME, function()
                if holding and myToken == holdToken and msgId then
                    openHoldMenu(msgId, sender, dispName or sender, text, bub, isPrivate)
                end
                holdStarted = false
            end)
        end

        local function endHold()
            holding = false
            holdStarted = false
            holdToken = holdToken + 1
        end

        local function activateSwipeReply()
            if swipeTriggered then return end
            swipeTriggered = true
            replyingToMsg = {sender = dispName or sender, text = text}
