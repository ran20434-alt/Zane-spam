addMsg = function(sender, dispName, text, parentScroll, isImg, imgUrl, senderUserId, msgId, replyData, reaction, isPrivate) 
    playNotificationSound()

    local targetScroll = parentScroll or MsgScroll
    local targetUserId = senderUserId or UserId
