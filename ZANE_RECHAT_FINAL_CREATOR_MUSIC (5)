function showSocialProfile(target)
    if not target then return end
    currentSocialProfileTarget = target
    SocialProfileFrame.Visible = true
    LeaderboardScroll.Visible = false
    LeaderboardTitle.Text = "👤 Profile"
    SocialProfileName.Text = target.DisplayName or target.Name
    SocialProfileUsername.Text = "@" .. target.Name
    SocialProfileRank.Text = "Loading profile..."
    setSocialProfileFollowState(false)
    SocialFollowBtn.Active = target.UserId ~= UserId
    if target.UserId == UserId then
        SocialFollowBtn.Text = "Your profile"
        SocialFollowBtn.BackgroundColor3 = ARES_BLUE_PANEL
    end
    task.spawn(function()
        local followers = getSocialCount("followers", target.UserId)
        local following = getSocialCount("following", target.UserId)
        local isTargetFollowed = target.UserId ~= UserId and isFollowing(target.UserId)
        if currentSocialProfileTarget ~= target then return end
        local assignedRank = getSpecialRank(target.Name)
        SocialProfileRank.Text = assignedRank and assignedRank.title or getFollowerRank(followers)
        SocialFollowersBtn.Text = tostring(followers) .. "\nFollowers"
        SocialFollowingBtn.Text = tostring(following) .. "\nFollowing"
        setSocialProfileFollowState(isTargetFollowed)
        task.spawn(function()
            pcall(function()
                local image = Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                if SocialProfileAvatar and SocialProfileAvatar.Parent then SocialProfileAvatar.Image = image end
            end)
        end)
    end)
