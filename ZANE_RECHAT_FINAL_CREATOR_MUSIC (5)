-- Dynamic Firebase Rank Store
local DYNAMIC_RANKS = {}

local function getSpecialRank(username)
    if not username then return nil end
    local lowerName = string.lower(username)
    if DYNAMIC_RANKS[lowerName] ~= nil then
        if DYNAMIC_RANKS[lowerName] == false or DYNAMIC_RANKS[lowerName].title == "[MEMBER]" or DYNAMIC_RANKS[lowerName].title == "NONE" then
            return nil
        end
        return DYNAMIC_RANKS[lowerName]
    end
    return SPECIAL_RANKS[lowerName]
end

local function isDirectorUser(name)
    local rank = getSpecialRank(name)
    return rank and rank.title == "[DIRECTOR]"
end

local function isCreatorUser(name)
    if name == PlayerName and CREATOR_USER_IDS[UserId] then
        return true
    end
    local rank = getSpecialRank(name)
    return rank and (rank.title == "[CREATOR]" or rank.title == "[DIRECTOR]")
end

local function hasAdminAccess(name)
    return isDirectorUser(name) or isCreatorUser(name)
end

-- Check if user has music-only permission (APEX_SHADOW728 only)
local function hasMusicAccess(name)
    local lowerName = string.lower(name)
    return (name == PlayerName and CREATOR_USER_IDS[UserId]) or lowerName == "apex_shadow728"
end

-- The Music tab is private to the Creator and Directors. The Creator is
-- identified by the configured UserId; Director usernames are rank-gated.
local function hasCreatorMusicTabAccess()
    return CREATOR_USER_IDS[UserId] == true or isDirectorUser(PlayerName) == true
end

local function hasStaffBroadcastAccess(name)
    return hasAdminAccess(name) or hasMusicAccess(name)
end

local function hasElevatedCommandAccess(name)
    return hasStaffBroadcastAccess(name) or COMMAND_ACCESS_USERS[string.lower(name or "")] == true
end

