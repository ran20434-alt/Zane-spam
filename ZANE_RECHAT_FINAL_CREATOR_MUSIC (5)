function refreshLeaderboard()
    clearLeaderboardRows()
    currentSocialProfileTarget = nil
    SocialProfileFrame.Visible = false
    LeaderboardScroll.Visible = true
    LeaderboardTitle.Text = "🌍 GLOBAL TOP 200 • FOLLOWERS"

    local globalData = getFirebaseData(GLOBAL_SOCIAL_USERS_PATH) or {}
    local playersById = {}
    for userId, profile in pairs(globalData) do
        if type(profile) == "table" and tonumber(profile.userId or userId) then
            profile.userId = tonumber(profile.userId or userId)
            profile.followerCount = tonumber(profile.followerCount) or 0
            playersById[tostring(profile.userId)] = profile
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local key = socialUserKey(player.UserId)
        local followerCount = getFollowerCount(player.UserId)
        playersById[key] = {
            userId = player.UserId,
            username = player.Name,
            displayName = player.DisplayName,
            followerCount = followerCount,
            followingCount = getSocialCount("following", player.UserId),
            rank = getFollowerRank(followerCount),
            lastSeen = os.time()
        }
        task.spawn(syncGlobalSocialProfile, player)
    end

    local playerRows = {}
    for _, profile in pairs(playersById) do
        table.insert(playerRows, profile)
    end
    table.sort(playerRows, function(a, b)
        local aFollowers = tonumber(a.followerCount) or 0
        local bFollowers = tonumber(b.followerCount) or 0
        if aFollowers == bFollowers then
            return tostring(a.username or a.displayName or ""):lower() < tostring(b.username or b.displayName or ""):lower()
        end
        return aFollowers > bFollowers
    end)

    for index = 1, math.min(200, #playerRows) do
        local profile = playerRows[index]
        local rankInfo = getSpecialRank(profile.username)
        local followerCount = tonumber(profile.followerCount) or 0
        local rankText = rankInfo and "" or getFollowerRank(followerCount)
        local roleText = rankInfo and (" " .. rankInfo.title) or ""
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 34)
        row.BackgroundColor3 = ARES_BLUE_PANEL
        row.TextColor3 = C.WHITE
        row.TextSize = 11
        row.Font = Enum.Font.Gotham
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.AutoButtonColor = true
        row.Text = string.format("  #%d   %s%s   %s (@%s)   • %d followers", index, rankText, roleText, tostring(profile.displayName or profile.username or "Unknown"), tostring(profile.username or "unknown"), followerCount)
        row.ZIndex = 503
        row.LayoutOrder = index
        row.Parent = LeaderboardScroll
        corner(row, 6)
        row.MouseButton1Click:Connect(function()
            showSocialProfile({
                UserId = tonumber(profile.userId),
                Name = tostring(profile.username or profile.displayName or "Unknown"),
                DisplayName = tostring(profile.displayName or profile.username or "Unknown")
            })
        end)
    end
end

local function refreshSocialList(kind, ownerUserId, ownerName)
    clearLeaderboardRows()
    SocialProfileFrame.Visible = false
    LeaderboardScroll.Visible = true
    ownerUserId = ownerUserId or UserId
    local title = kind == "followers" and ((ownerName and ("👥 @" .. ownerName .. "'s Followers")) or "👥 My Followers") or ((ownerName and ("👤 @" .. ownerName .. " Following")) or "👤 Following")
    LeaderboardTitle.Text = title
    local entries = getSocialList(kind, ownerUserId)
    local rows = {}
    for _, data in pairs(entries) do
        if type(data) == "table" then table.insert(rows, data) end
    end
    table.sort(rows, function(a, b)
        return tostring(a.username or a.displayName or ""):lower() < tostring(b.username or b.displayName or ""):lower()
    end)
    if #rows == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 34)
        empty.BackgroundColor3 = ARES_BLUE_PANEL
        empty.TextColor3 = C.GRAY
