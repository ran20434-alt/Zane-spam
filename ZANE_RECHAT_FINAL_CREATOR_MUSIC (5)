        empty.Font = Enum.Font.Gotham
        empty.Text = kind == "followers" and "No followers yet." or "You are not following anyone yet."
        empty.Parent = LeaderboardScroll
        corner(empty, 6)
        return
    end
    for index, data in ipairs(rows) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 32)
        row.BackgroundColor3 = ARES_BLUE_PANEL
        row.TextColor3 = C.WHITE
        row.TextSize = 11
        row.Font = Enum.Font.Gotham
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.AutoButtonColor = true
        row.Text = string.format("  #%d   %s (@%s)", index, tostring(data.displayName or data.username or "Unknown"), tostring(data.username or "unknown"))
        row.LayoutOrder = index
        row.ZIndex = 503
        row.Parent = LeaderboardScroll
        corner(row, 6)
        row.MouseButton1Click:Connect(function()
            local target = findOnlinePlayer(data.username or data.displayName)
            if not target and tonumber(data.userId) then
                target = {
                    UserId = tonumber(data.userId),
                    Name = tostring(data.username or data.displayName or "Unknown"),
                    DisplayName = tostring(data.displayName or data.username or "Unknown")
                }
            end
            if target then
                showSocialProfile(target)
            else
                sendBigWhiteNotification("⚠️ This player is not currently in the server.")
            end
        end)
    end
end

