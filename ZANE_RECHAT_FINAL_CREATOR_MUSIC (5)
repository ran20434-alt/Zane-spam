-- Repaint visible chat names whenever Firebase ranks change so the grantee,
-- the sender, and every other client see the same rank without rejoining.
local function refreshExistingChatRanks()
    for _, data in pairs(messageTextLabels) do
        local label = data.label
        if label and label.Parent then
            local rankInfo = data.isPrivate and nil or getSpecialRank(data.sender)
            local followerTag = data.isPrivate and "[PVT]" or (rankInfo and "" or (FollowerTagCache[data.senderUserId] or ""))
            local taggedName = (followerTag ~= "" and followerTag .. " " or "") .. (data.dispName or data.sender)
            data.rankInfo = rankInfo
            if rankInfo and rankInfo.type == "rgb" then
                RgbLabels[label] = {
                    rankTitle = rankInfo.title,
                    dispName = taggedName,
                    msgText = data.text or "",
                    isImg = data.isImg == true
                }
            elseif rankInfo and rankInfo.color then
                RgbLabels[label] = nil
                local hex = string.format("#%02X%02X%02X", math.floor(rankInfo.color.R * 255), math.floor(rankInfo.color.G * 255), math.floor(rankInfo.color.B * 255))
                if data.isImg then
                    label.Text = string.format("<font color=\"%s\"><b>%s</b></font> <b>%s</b>", hex, rankInfo.title, taggedName)
                else
                    label.Text = string.format("<font color=\"%s\"><b>%s</b></font> <b>%s:</b> %s", hex, rankInfo.title, taggedName, data.text or "")
                end
            else
                RgbLabels[label] = nil
                label.Text = data.isImg and ("<b>" .. taggedName .. "</b>") or string.format("<b>%s:</b> %s", taggedName, data.text or "")
            end
        end
    end
end

