-- Creator/Director local YouTube player state, based on Ytmusicletfix.
-- This is intentionally separate from Firebase global_music: downloaded
-- executor audio is local to the current client and cannot be synchronized.
local creatorMusic = {
    sound = nil,
    title = "No music playing",
    volume = 0.8,
    looping = false,
    playing = false,
    queue = {}
}
local creatorMusicFolder = "TATrMusic/"
local creatorMusicApiKeys = {
    "21fbd971d02303568cf35043e7993dafc4ddf260",
    "bbef82fcaaf5e3272e8c2b7e373239add6f0a5ad",
    "13e24bc93edbe1f693dd89ca192ed67b63e7eae4",
    "8e478fd61e30968d16db9e542402d4782738a201",
    "c9aa069e6bf1b0714c2c407f8370fa273c1485ec"
}

local function creatorMusicUrlEncode(value)
    return tostring(value):gsub("([^%w%-%.%_%~])", function(char)
        return string.format("%%%02X", char:byte())
    end)
end

local function creatorMusicGetJson(url)
    if not httpRequest then return nil, "No HTTP request function" end
    local ok, response = pcall(httpRequest, {Url = url, Method = "GET"})
    if not ok or not response or not response.Body or response.Body == "" then
        return nil, "No response"
    end
    local decodedOk, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
    if not decodedOk then return nil, "Bad JSON" end
    return decoded
end

local function creatorMusicStartLocalSound(filePath, title)
    if not getcustomasset and not filePath then return false, "No local asset loader" end
    if creatorMusic.sound then
        pcall(function()
            creatorMusic.sound:Stop()
            creatorMusic.sound:Destroy()
        end)
    end
    local sound = Instance.new("Sound")
    sound.Name = "ZaNeCreatorMusic"
    sound.Volume = creatorMusic.volume
    sound.Looped = creatorMusic.looping
    sound.Parent = SoundService
    if getcustomasset then
        sound.SoundId = getcustomasset(filePath)
    else
        sound.SoundId = "rbxasset://" .. filePath
    end
    local ok = pcall(function() sound:Play() end)
    if not ok then
        sound:Destroy()
        return false, "Playback error"
    end
    creatorMusic.sound = sound
    creatorMusic.title = title or "YouTube Audio"
    creatorMusic.playing = true
    sound.Ended:Connect(function()
        creatorMusic.playing = false
        if creatorMusic.looping then return end
        local nextTrack = table.remove(creatorMusic.queue, 1)
        if nextTrack then
            creatorMusicStartLocalSound(nextTrack.path, nextTrack.title)
        end
    end)
    return true
end

local function creatorMusicDownloadYouTube(url, updateStatus)
    task.spawn(function()
        if not url or (not url:match("youtube%.com") and not url:match("youtu%.be")) then
            updateStatus("Invalid YouTube URL", "")
            return
        end
        if not httpRequest or not writefile or not isfolder or not makefolder then
            updateStatus("Executor file/HTTP APIs unavailable", "")
            return
        end
        if not isfolder(creatorMusicFolder) then makefolder(creatorMusicFolder) end
        updateStatus("Starting...", "Waiting...")
        local jobId, jobInfo, lastError
        for _, apiKey in ipairs(creatorMusicApiKeys) do
            local endpoint = "https://p.savenow.to/ajax/download.php?url=" .. creatorMusicUrlEncode(url) .. "&format=mp3&apikey=" .. apiKey .. "&add_info=1&allow_extended_duration=1&no_merge=0"
            local response, err = creatorMusicGetJson(endpoint)
            if response and response.id then
                jobId, jobInfo = response.id, response
                break
            end
            lastError = (response and response.error) or err or "Download request failed"
            task.wait(0.3)
        end
        if not jobId then
            updateStatus(tostring(lastError or "Download failed"):sub(1, 40), "")
            return
        end
        local deadline = tick() + 300
        local downloadUrl, downloadInfo
        while tick() < deadline do
            local progress = creatorMusicGetJson("https://p.savenow.to/ajax/progress.php?id=" .. tostring(jobId))
            if progress then
                local rawProgress = tonumber(progress.progress) or 0
                local percent = math.clamp(rawProgress > 100 and math.floor(rawProgress / 10) or math.floor(rawProgress), 0, 100)
                updateStatus(percent .. "%", "Progress: " .. percent .. "%")
                if rawProgress >= 1000 and progress.download_url then
                    downloadUrl, downloadInfo = progress.download_url, progress
                    break
                end
                if progress.error and progress.error ~= "" then
                    updateStatus(tostring(progress.error):sub(1, 40), "")
                    return
                end
            end
            task.wait(1.5)
        end
        if not downloadUrl then
            updateStatus("Timeout", "")
            return
        end
        updateStatus("Saving...", "Writing...")
        local title = (downloadInfo and downloadInfo.title) or (jobInfo and jobInfo.title) or "YouTube Audio"
        local fileName = creatorMusicFolder .. "tat_" .. tostring(jobId):sub(-8) .. ".mp3"
        local ok, response = pcall(httpRequest, {Url = downloadUrl, Method = "GET"})
        if not ok or not response or not response.Body then
            updateStatus("Save error", "")
            return
        end
        writefile(fileName, response.Body)
        updateStatus("Done!", "Saved")
        task.wait(0.3)
        local played, playError = creatorMusicStartLocalSound(fileName, title)
        if not played then updateStatus(playError or "Playback error", "") end
    end)
end

