-- Load Dynamic Ranks
local function syncRanks()
    local ranksData = getFirebaseData("dynamic_ranks")
    if ranksData then
        DYNAMIC_RANKS = {}
        for user, rData in pairs(ranksData) do
            if type(rData) == "table" then
                if rData.expiresAt and tonumber(rData.expiresAt) and tonumber(rData.expiresAt) <= os.time() then
                    DYNAMIC_RANKS[user:lower()] = false
                elseif rData.title == "NONE" or rData.removed == true then
                    DYNAMIC_RANKS[user:lower()] = false
                elseif rData.type == "rgb" then
                    DYNAMIC_RANKS[user:lower()] = {title = rData.title, type = "rgb"}
                elseif rData.r and rData.g and rData.b then
                    DYNAMIC_RANKS[user:lower()] = {title = rData.title, color = Color3.fromRGB(rData.r, rData.g, rData.b)}
                else
                    DYNAMIC_RANKS[user:lower()] = {title = rData.title, color = Color3.fromRGB(255, 215, 0)}
                end
            end
        end
    end
end
